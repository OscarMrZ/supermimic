# Partial stub: mujoco 4.x ships its API (MjModel, MjSpec, mj_* functions, mjt*
# enums) from compiled pybind11 modules without type stubs, so pyright cannot see
# the names `mujoco/__init__.py` star-imports from them. They are declared here
# with untyped members; the package's Python submodules (viewer, renderer, ...)
# keep their own types.
from typing import Any

class _Untyped(type):
  def __getattr__(cls, name: str) -> Any: ...

class _Struct(metaclass=_Untyped):
  def __init__(self, *args: Any, **kwargs: Any) -> None: ...
  def __getattr__(self, name: str) -> Any: ...
  def __setattr__(self, name: str, value: Any) -> None: ...

class MjModel(_Struct): ...
class MjData(_Struct): ...
class MjSpec(_Struct): ...
class mjtJoint(_Struct): ...
class mjtObj(_Struct): ...

def __getattr__(name: str) -> Any: ...
